# Environment Variables
# Copy this file to .env and fill in your values.
# Mock mode is enabled by default — no real credentials needed to run locally.

# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=notifications
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── RabbitMQ ──────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Email (SendGrid) ──────────────────────────────────
# Set MOCK_EMAIL=true to log emails to stdout instead of sending
MOCK_EMAIL=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com

# ── SMS (Twilio) ──────────────────────────────────────
# Set MOCK_SMS=true to log SMS to stdout instead of sending
MOCK_SMS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Push (FCM) ────────────────────────────────────────
# Set MOCK_PUSH=true to log push notifications to stdout instead of sending
MOCK_PUSH=true
FCM_SERVER_KEY=

# ── Internal Service URLs (override only if not using Docker Compose) ─
# INAPP_SERVICE_URL=http://inapp_service:8001
